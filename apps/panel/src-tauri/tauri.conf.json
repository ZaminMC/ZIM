{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZaminPanel",
  "version": "0.1.0",
  "identifier": "mc.zamin.panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZaminPanel",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "app", "dmg"],
    "icon": []
  }
}
